{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  /* worker-configuration.d.ts is generated by `pnpm run types` (wrangler
     types) from wrangler.jsonc's bindings - gitignored, regenerate after any
     wrangler.jsonc binding change. It is what makes the ambient `Env` type
     (and Request/Response/D1Database/R2Bucket/KVNamespace/ExecutionContext)
     available with no import, matching what the Worker sees at runtime. */
  "include": ["src/**/*", "worker-configuration.d.ts"]
}
