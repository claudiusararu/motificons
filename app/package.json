{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "astro check",
    "build": "astro check && node scripts/build-og-image.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "dev:clean": "rm -rf node_modules/.vite && node scripts/dev.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.0",
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
