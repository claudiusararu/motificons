---
import { faqSchema, type Faq } from "../lib/site";

interface Props {
  title?: string;
  faqs: Faq[];
  class?: string;
}

const { title = "Questions", faqs, class: className } = Astro.props;
---

{/* Native <details> rather than a scripted disclosure: it is keyboard
    operable, screen-reader announced and correct before any JavaScript runs,
    which for an SEO surface matters more than a custom animation. The schema
    below carries every answer regardless of what is collapsed, so a collapsed
    accordion is never a hidden-content problem. */}
<section class:list={["w-full", className]}>
  <h2 class="text-h2 font-semibold">{title}</h2>

  <div class="mt-8 border-t-2 border-ink/15">
    {
      faqs.map((faq) => (
        <details class="faq-item group border-b-2 border-ink/15">
          <summary
            class="flex w-full cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-h3 font-semibold text-ink"
          >
            {faq.q}
            <span
              class="faq-chevron inline-flex size-9 shrink-0 items-center justify-center rounded-control border-2 border-ink bg-surface text-ink"
              aria-hidden="true"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>
          <p class="pb-7 text-ink">{faq.a}</p>
        </details>
      ))
    }
  </div>
</section>

<script
  type="application/ld+json"
  is:inline
  set:html={faqSchema(faqs)}
/>
