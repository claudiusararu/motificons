---
import Icon, { ICONS, type IconName } from "./Icon.astro";

/**
 * Faint field of icon glyphs behind the hero.
 *
 * Decorative only: aria-hidden, pointer-events off, drawn in ink at very low
 * opacity so it reads as texture rather than content. The hero text sits on
 * top at full ink, so contrast is unaffected.
 *
 * Scattered, not gridded. A plain CSS grid put every glyph on a shared
 * baseline and the rows were plainly visible, which is the opposite of the
 * intended texture. This jitters each glyph off its cell by up to half a cell
 * in both axes and varies size, rotation and opacity, so no row or column
 * survives while coverage stays even - pure randomness clumps and leaves bald
 * patches, which is the other way to get this wrong.
 *
 * The generator is seeded, so the field is identical on every build and never
 * reflows between renders.
 */
const GLYPHS = Object.keys(ICONS) as IconName[];

/** mulberry32: tiny, fast, and stable across runtimes. */
function seeded(seed: number): () => number {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const COLUMNS = 9;
const ROWS = 6;
/* Fixed seed: the field must be identical on every build. */
const random = seeded(0x5eed1c04);

const cells = Array.from({ length: COLUMNS * ROWS }, (_, index) => {
  const column = index % COLUMNS;
  const row = Math.floor(index / COLUMNS);

  /* Cell centre, then jitter by up to half a cell. Coverage stays even
     because every cell still contributes one glyph. */
  const jitterX = (random() - 0.5) * 0.9;
  const jitterY = (random() - 0.5) * 0.9;
  const left = ((column + 0.5 + jitterX) / COLUMNS) * 100;
  const top = ((row + 0.5 + jitterY) / ROWS) * 100;

  return {
    glyph: GLYPHS[Math.floor(random() * GLYPHS.length)]!,
    left: Math.max(-2, Math.min(100, left)),
    top: Math.max(-2, Math.min(100, top)),
    size: Math.round(18 + random() * 26),
    rotation: Math.round((random() - 0.5) * 40),
    /* Varied opacity gives the field depth instead of a flat stencil. */
    opacity: (0.035 + random() * 0.04).toFixed(3),
  };
});
---

<div
  aria-hidden="true"
  class="pointer-events-none absolute inset-0 overflow-hidden select-none"
>
  {
    cells.map((cell) => (
      <span
        class="absolute text-ink"
        style={`left:${cell.left.toFixed(2)}%;top:${cell.top.toFixed(2)}%;opacity:${cell.opacity};transform:translate(-50%,-50%) rotate(${cell.rotation}deg)`}
      >
        <Icon name={cell.glyph} size={cell.size} />
      </span>
    ))
  }
</div>
