---
import Logo from "./Logo.astro";
import { TOOLS } from "../pages/tools/_tool-data";

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const COLUMNS: { title: string; links: FooterLink[] }[] = [
  {
    title: "Icons",
    links: [
      { label: "Browse icons", href: "/search" },
      { label: "Categories", href: "/categories" },
      { label: "Licenses", href: "/licenses" },
    ],
  },
  {
    title: "Tools",
    /* Driven by the same registry the tool pages themselves come from
       (counts and lists are data, never hand-maintained) - a new converter
       page shows up here automatically. */
    links: TOOLS.map((tool) => ({
      label: tool.name,
      href: `/tools/${tool.slug}`,
    })),
  },
  {
    title: "Product",
    links: [
      { label: "For agents", href: "/agents" },
      { label: "Blog", href: "/blog" },
      { label: "Licenses", href: "/licenses" },
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
    ],
  },
  {
    title: "Built on",
    links: [
      { label: "Iconify", href: "https://iconify.design", external: true },
      {
        label: "Open Color",
        href: "https://yeun.github.io/open-color/",
        external: true,
      },
      {
        label: "Nunito",
        href: "https://fonts.google.com/specimen/Nunito",
        external: true,
      },
    ],
  },
];

const year = new Date().getFullYear();
---

{/* Navy footer, light text, link columns, external links open in a
    new tab with a safe rel. */}
<footer class:list={["on-navy bg-ink text-on-dark", className]}>
  <div class="page-container py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-[280px]">
        <Logo onDark />
        <p class="mt-3 text-meta text-on-dark-muted">
          Open-source icons for humans and coding agents. Free, and open
          source itself.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-12 gap-y-10 sm:grid-cols-4">
        {
          COLUMNS.map((column) => (
            <div>
              <h2 class="text-pill font-bold text-on-dark-muted uppercase">
                {column.title}
              </h2>
              <ul class="mt-4 flex flex-col gap-3">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      {...link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {}}
                      class="text-meta text-on-dark no-underline transition-colors duration-[120ms] ease-in hover:text-primary"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-2 border-t border-ink-shadow-soft pt-8 text-meta text-on-dark-muted sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        &copy; {year} Motificons &middot; also from the maker:{" "}
        <a
          href="https://aerolaunch.app"
          target="_blank"
          rel="noopener"
          class="text-on-dark no-underline transition-colors duration-[120ms] ease-in hover:text-primary"
        >
          AeroLaunch
        </a>
      </p>
      <p>Icon sets stay under their own licenses, credited to their authors.</p>
    </div>
  </div>
</footer>
